@@ -0,0 +1,109 @@
+import { useState } from "react";
+import { TrendingUp, TrendingDown, Minus, Loader2 } from "lucide-react";
+import { CROP_LIST, matchCropFromText, getMarketAdvice } from "./assistantData";
+
+const ACTION_META = {
+  SELL_NOW: { icon: TrendingDown, key: "sellNow", className: "action-sell" },
+  WAIT: { icon: TrendingUp, key: "wait", className: "action-wait" },
+  SELL_PARTIALLY: { icon: Minus, key: "sellPartially", className: "action-partial" },
+};
+
+export default function MarketAdvisor({ t, defaultCrop, onAdvised }) {
+  const [query, setQuery] = useState(
+    defaultCrop ? `Should I sell ${defaultCrop.toLowerCase()} today?` : ""
+  );
+  const [crop, setCrop] = useState(defaultCrop || CROP_LIST[0]);
+  const [loading, setLoading] = useState(false);
+  const [advice, setAdvice] = useState(null);
+
+  const handleAsk = async () => {
+    const matched = matchCropFromText(query) || crop;
+    setCrop(matched);
+    setLoading(true);
+    const result = await getMarketAdvice(matched);
+    setLoading(false);
+    setAdvice(result);
+    onAdvised?.(result);
+  };
+
+  const meta = advice ? ACTION_META[advice.action] : null;
+  const ActionIcon = meta?.icon;
+
+  return (
+    <div className="assistant-panel market-panel">
+      <div className="market-query-row">
+        <input
+          type="text"
+          value={query}
+          placeholder={t.askMarketPlaceholder}
+          onChange={(e) => setQuery(e.target.value)}
+          onKeyDown={(e) => e.key === "Enter" && handleAsk()}
+        />
+        <button
+          type="button"
+          className="primary-button"
+          onClick={handleAsk}
+          disabled={loading}
+        >
+          {loading ? <Loader2 size={16} className="spin" /> : t.getAdvice}
+        </button>
+      </div>
+
+      <div className="market-crop-select">
+        <label>{t.selectCrop}</label>
+        <select value={crop} onChange={(e) => setCrop(e.target.value)}>
+          {CROP_LIST.map((c) => (
+            <option key={c} value={c}>
+              {c}
+            </option>
+          ))}
+        </select>
+      </div>
+
+      {advice && (
+        <div className="market-result">
+          <span className="demo-badge">{t.demoMarketLabel}</span>
+
+          <div className={`market-action-pill ${meta.className}`}>
+            {ActionIcon && <ActionIcon size={16} />}
+            {t[meta.key]}
+          </div>
+
+          <div className="confidence-bar">
+            <div
+              className="confidence-bar-fill"
+              style={{ width: `${advice.confidence}%` }}
+            />
+            <span>
+              {t.confidence}: {advice.confidence}%
+            </span>
+          </div>
+
+          <div className="market-stats">
+            <div>
+              <span>₹{advice.currentPrice}</span>
+              <small>/quintal</small>
+            </div>
+            <div>
+              <span>{advice.trend > 0 ? "+" : ""}{advice.trend}%</span>
+              <small>trend</small>
+            </div>
+            <div>
+              <span>{advice.demand}</span>
+              <small>demand</small>
+            </div>
+          </div>
+
+          <div className="diagnosis-detail">
+            <h5>{t.marketReasoning}</h5>
+            <ul>
+              {advice.reasons.map((r, i) => (
+                <li key={i}>{r}</li>
+              ))}
+            </ul>
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/src/components/assistant/VoiceRecorder.jsx b/src/components/assistant/VoiceRecorder.jsx
new file mode 100644
index 0000000..19e3dfd
--- /dev/null
+++ b/src/components/assistant/VoiceRecorder.jsx
@@ -0,0 +1,124 @@
+import { useEffect, useRef, useState } from "react";
+import { Mic, MicOff } from "lucide-react";
+import { SPEECH_LOCALE } from "./assistantData";
+
+// Wraps the browser's Web Speech API for speech-to-text, with a clearly
+// disabled state when it isn't available. Also exposes a small helper to
+// speak text back (speechSynthesis) for text-to-speech replies.
+export default function VoiceRecorder({ language, t, onResult, disabled }) {
+  const [listening, setListening] = useState(false);
+  const [interim, setInterim] = useState("");
+  const recognitionRef = useRef(null);
+
+  const SpeechRecognitionImpl =
+    typeof window !== "undefined" &&
+    (window.SpeechRecognition || window.webkitSpeechRecognition);
+
+  const supported = Boolean(SpeechRecognitionImpl);
+
+  useEffect(() => {
+    return () => {
+      recognitionRef.current?.stop?.();
+    };
+  }, []);
+
+  const startListening = () => {
+    if (!supported || disabled) return;
+
+    const recognition = new SpeechRecognitionImpl();
+    recognition.lang = SPEECH_LOCALE[language] || "en-IN";
+    recognition.interimResults = true;
+    recognition.continuous = false;
+    recognition.maxAlternatives = 1;
+
+    recognition.onstart = () => setListening(true);
+    recognition.onerror = () => setListening(false);
+    recognition.onend = () => {
+      setListening(false);
+      setInterim("");
+    };
+
+    recognition.onresult = (event) => {
+      let finalText = "";
+      let interimText = "";
+
+      for (let i = event.resultIndex; i < event.results.length; i++) {
+        const transcript = event.results[i][0].transcript;
+        if (event.results[i].isFinal) {
+          finalText += transcript;
+        } else {
+          interimText += transcript;
+        }
+      }
+
+      if (interimText) setInterim(interimText);
+      if (finalText) {
+        setInterim("");
+        onResult?.(finalText.trim());
+        recognition.stop();
+      }
+    };
+
+    recognitionRef.current = recognition;
+    recognition.start();
+  };
+
+  const stopListening = () => {
+    recognitionRef.current?.stop?.();
+    setListening(false);
+  };
+
+  if (!supported) {
+    return (
+      <div className="voice-recorder voice-unsupported" title={t.micNotSupported}>
+        <MicOff size={16} />
+        <span>{t.micNotSupported}</span>
+      </div>
+    );
+  }
+
+  return (
+    <div className="voice-recorder">
+      <button
+        type="button"
+        className={`mic-button ${listening ? "listening" : ""}`}
+        onClick={listening ? stopListening : startListening}
+        disabled={disabled}
+        aria-label={listening ? t.micListening : t.micStart}
+        title={listening ? t.micListening : t.micStart}
+      >
+        <Mic size={18} />
+      </button>
+
+      {listening && (
+        <div className="mic-waveform" aria-hidden="true">
+          <span />
+          <span />
+          <span />
+          <span />
+          <span />
+        </div>
+      )}
+
+      {listening && (
+        <span className="mic-status">{interim || t.micListening}</span>
+      )}
+    </div>
+  );
+}
+
+// Simple text-to-speech helper. Falls back to a no-op if unsupported.
+export function speakText(text, language) {
+  if (typeof window === "undefined" || !window.speechSynthesis) return;
+
+  window.speechSynthesis.cancel();
+
+  const utterance = new SpeechSynthesisUtterance(text);
+  utterance.lang = SPEECH_LOCALE[language] || "en-IN";
+
+  const voices = window.speechSynthesis.getVoices();
+  const match = voices.find((v) => v.lang === utterance.lang);
+  if (match) utterance.voice = match;
+
+  window.speechSynthesis.speak(utterance);
+}
