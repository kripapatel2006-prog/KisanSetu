+function seededRandom(seedStr) {
+  let seed = 0;
+  for (let i = 0; i < seedStr.length; i++) {
+    seed = (seed * 31 + seedStr.charCodeAt(i)) % 100000;
+  }
+  return seed / 100000;
+}
